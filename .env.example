# TEOS Answering Engine LLM Configuration
# Uncomment and configure the providers you want to use

# Local/Ollama (Primary - Free & Private)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Free Cloud Tiers
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama3-8b-8192

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Optional Paid Providers (uncomment to use)
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-3.5-turbo

# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTHROPIC_MODEL=claude-3-haiku-20240307

# Provider Selection Order (optional - defaults to Ollama → Groq → Gemini)
# LLM_PROVIDER_PRIORITY=ollama,groq,gemini,openai,anthropic
