# TEOS Answering Engine LLM Configuration
# Uncomment and configure the providers you want to use

# Local/Ollama (Primary - Free & Private)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Free Cloud Tiers
GROQ_API_KEY=your_groq_api_key_here
# Served Groq model (default; override via this var)
GROQ_MODEL=openai/gpt-oss-120b

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Optional Paid Providers (uncomment to use)
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-3.5-turbo

# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTHROPIC_MODEL=claude-3-haiku-20240307

# Provider Selection Order (optional - defaults to Ollama → Groq → Gemini)
# LLM_PROVIDER_PRIORITY=ollama,groq,gemini,openai,anthropic

# ── TEOS AI Agent (milestone 1) ────────────────────────────────────────────
# The agent runs behind the private TEOS AI Agent Service. These values are
# SERVER-ONLY: never expose the service key to the browser.

# Private network URL of the agent service
TEOS_AGENT_URL=http://teos-agent:8000
# Service-to-service secret (server only)
TEOS_AGENT_API_KEY=replace-with-service-key
# Per-run deadline in milliseconds
TEOS_AGENT_TIMEOUT_MS=150000

# Abuse protection (in-memory fixed window; resets per instance)
TEOS_AGENT_RATE_LIMIT_PER_MIN=12

# ── Public chat route (server-side LLM bridge) ────────────────────────────────
# POST /api/teos/chat runs llmService SERVER-ONLY (the chat widget used to call
# it from the browser, where GROQ/GEMINI keys can never be present). Set the
# cloud provider keys here; never ship them to the client.
TEOS_CHAT_RATE_LIMIT_PER_MIN=12

# Server-side audit trail (JSONL). Stores message digests + lengths only —
# never raw query text, never tokens or keys.
TEOS_AGENT_AUDIT_DIR=./data/audit

# ── Backend (restore when a live backend exists) ────────────────────────────
# Base URL read by lib/system-config.ts (public value). Replace after restoring
# a live backend.
NEXT_PUBLIC_BACKEND_URL=https://backend.invalid
